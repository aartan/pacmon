{
  "name": "pacmon",
  "version": "0.1.0",
  "description": "Local-first package vulnerability monitoring and remediation for developers",
  "main": "./out/main/index.js",
  "author": "Abdifatah Artan",
  "homepage": "https://github.com/aartan/guardrail",
  "desktopName": "pacmon.desktop",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:linux": "npm run build && electron-builder --linux",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win",
    "icons": "node scripts/build-icon.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "cve-lite-cli": "1.42.0",
    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.8",
    "@swc/core": "^1.16.22",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.7.0",
    "@vitejs/plugin-react": "^6.3.0",
    "clsx": "^2.1.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "execa": "^8.0.1",
    "framer-motion": "^14.14.0",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.79.0",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "allowScripts": {
    "electron@45.4.1": true,
    "@swc/core@1.16.22": true,
    "electron-winstaller@5.4.0": true
  }
}
